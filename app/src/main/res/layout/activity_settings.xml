<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/settings_title" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_general" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:id="@+id/language_row"
                    style="@style/SettingsRow">

                    <ImageView
                        style="@style/SettingsRowIcon"
                        android:src="@drawable/ic_translate" />

                    <LinearLayout style="@style/SettingsRowText">

                        <TextView
                            style="@style/SettingsRowTitle"
                            android:text="@string/settings_language" />

                        <TextView
                            android:id="@+id/language_value"
                            style="@style/SettingsRowValue" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_storage" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_menu_book" />

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_storage_used" />

                            <TextView
                                android:id="@+id/storage_value"
                                style="@style/SettingsRowValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/delete_after_send_row"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_delete" />

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_delete_after_send" />

                            <TextView
                                style="@style/SettingsRowValue"
                                android:text="@string/settings_delete_after_send_detail" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/delete_after_send_switch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                style="@style/SettingsRowValue"
                android:layout_width="match_parent"
                android:layout_marginTop="8dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="@string/settings_storage_note" />

            <TextView
                style="@style/SettingsSection"
                android:text="@string/settings_section_about" />

            <com.google.android.material.card.MaterialCardView
                style="?attr/materialCardViewFilledStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="?attr/colorSurfaceContainer"
                app:cardCornerRadius="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        style="@style/SettingsRow"
                        android:background="@null">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_info" />

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_version" />

                            <TextView
                                android:id="@+id/version_value"
                                style="@style/SettingsRowValue" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/update_row"
                        style="@style/SettingsRow">

                        <ImageView
                            style="@style/SettingsRowIcon"
                            android:src="@drawable/ic_refresh" />

                        <LinearLayout style="@style/SettingsRowText">

                            <TextView
                                style="@style/SettingsRowTitle"
                                android:text="@string/settings_check_updates" />

                            <TextView
                                android:id="@+id/update_value"
                                style="@style/SettingsRowValue"
                                android:text="@string/update_idle" />
                        </LinearLayout>

                        <com.google.android.material.progressindicator.CircularProgressIndicator
                            android:id="@+id/update_progress"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:indeterminate="true"
                            android:visibility="gone"
                            app:indicatorSize="22dp"
                            app:trackThickness="3dp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
